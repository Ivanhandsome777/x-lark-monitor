# X Developer Portal 中的 Bearer Token
X_BEARER_TOKEN=replace_me

# 不带 @，使用英文逗号分隔
X_USERNAMES=OpenAI,elonmusk

# Lark 群自定义机器人 Webhook
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/replace_me

# 如果机器人启用了“签名校验”，填写这里；否则留空
LARK_SIGNING_SECRET=

# 本机无法直连 X API 时填写 HTTP/HTTPS 代理，例如 Clash HTTP 端口
X_PROXY_URL=

# stream：秒级推送（推荐）；poll：定时查询 recent search
X_MODE=stream
POLL_INTERVAL_SECONDS=60

# 是否推送回复、转帖
INCLUDE_REPLIES=false
INCLUDE_RETWEETS=false

# poll 模式首次启动时是否推送当前已查到的历史帖子
PUSH_EXISTING=false

# SQLite 去重与待重试队列
STATE_DB=/app/data/monitor.db
LOG_LEVEL=INFO
